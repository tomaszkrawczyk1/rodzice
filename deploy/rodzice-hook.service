[Unit]
Description=Webhook GitHub -> automatyczny deploy (rodzice)
After=network-online.target

[Service]
User=srv
EnvironmentFile=/home/srv/rodzice/hook.env
Environment=PORT=8788
ExecStart=/usr/bin/node /home/srv/rodzice/hook/hook.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
